---
import PageLayout from '../layouts/PageLayout.astro';
import { Lightbulb, Star, Palette, Image as ImageIcon } from '@lucide/astro';
---

<PageLayout
  title="Car-folie.pl - Inspiracje"
  description="Zmiana koloru aut folia, pełne oklejanie, grafika na pojazdach"
  currentPath="/inspiracje"
  bannerImage="/images/bg_inspiracje.jpg"
  bannerTitle="Inspiracje"
>
  <div class="container">
    <div class="content-page">
      <h2>Car-folie.pl - Inspiracje</h2>

      <div class="content-section">
        <p>
          Zobacz nasze realizacje i znajdź inspirację dla swojego projektu. Prezentujemy różne style, kolory i zastosowania folii samochodowych.
        </p>
      </div>

      <div class="content-section">
        <h3>Stylizacje</h3>
        <div class="styles-grid">
          <div class="style-card">
            <div class="style-preview">
              <div class="style-color" style="background: linear-gradient(135deg, #1a1a2e, #16213e);"></div>
            </div>
            <h4>Matowe wykończenia</h4>
            <p>
              Eleganckie, satynowe wykończenie bez połysku. Idealne dla luksusowych i sportowych samochodów.
            </p>
          </div>

          <div class="style-card">
            <div class="style-preview">
              <div class="style-color" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);"></div>
            </div>
            <h4>Błyszczące wykończenia</h4>
            <p>
              Klasyczne, lśniące wykończenie. Najpopularniejszy wybór dla większości kolorów.
            </p>
          </div>

          <div class="style-card">
            <div class="style-preview">
              <div class="style-color" style="background: linear-gradient(135deg, #7c3aed, #64b5f6);"></div>
            </div>
            <h4>Metaliczne efekty</h4>
            <p>
              Z drobinkami metalicznymi, tworzącymi efekt głębi i połysku.
            </p>
          </div>

          <div class="style-card">
            <div class="style-preview">
              <div class="style-color" style="background: linear-gradient(135deg, #f093fb, #f5576c);"></div>
            </div>
            <h4>Perłowe wykończenia</h4>
            <p>
              Delikatny perłowy blask, który zmienia się w zależności od kąta padania światła.
            </p>
          </div>

          <div class="style-card">
            <div class="style-preview">
              <div class="style-color" style="background: linear-gradient(135deg, #c0c0c0, #1a1a1a);"></div>
            </div>
            <h4>Chromowane efekty</h4>
            <p>
              Efekt lustrzanego chromu. Idealne do akcentów i detali.
            </p>
          </div>

          <div class="style-card">
            <div class="style-preview">
              <div class="style-color" style="background: linear-gradient(135deg, #2d3436, #000000);"></div>
            </div>
            <h4>Carbonowe wykończenia</h4>
            <p>
              Wzór włókna węglowego. Popularny do wnętrz i akcentów sportowych.
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Popularne kolory</h3>
        <div class="colors-grid">
          <div class="color-item">
            <div class="color-swatch" style="background: #000000;"></div>
            <h4>Czarny matowy</h4>
            <p>
              Klasyczny, elegancki kolor. Idealny dla każdego typu nadwozia.
            </p>
          </div>

          <div class="color-item">
            <div class="color-swatch" style="background: #ffffff;"></div>
            <h4>Biały perłowy</h4>
            <p>
              Elegancki biały z subtelnym perłowym efektem.
            </p>
          </div>

          <div class="color-item">
            <div class="color-swatch" style="background: #c0c0c0;"></div>
            <h4>Szary metaliczny</h4>
            <p>
              Nowoczesny szary z metalicznym efektem.
            </p>
          </div>

          <div class="color-item">
            <div class="color-swatch" style="background: #dc2626;"></div>
            <h4>Czerwony błyszczący</h4>
            <p>
              Wyrazisty kolor, który przyciąga uwagę.
            </p>
          </div>

          <div class="color-item">
            <div class="color-swatch" style="background: #2563eb;"></div>
            <h4>Niebieski metaliczny</h4>
            <p>
              Sportowy, dynamiczny kolor z efektem głębi.
            </p>
          </div>

          <div class="color-item">
            <div class="color-swatch" style="background: #f59e0b;"></div>
            <h4>Złoty metaliczny</h4>
            <p>
              Luksusowy, elegancki kolor z subtelnym połyskiem.
            </p>
          </div>

          <div class="color-item">
            <div class="color-swatch" style="background: #10b981;"></div>
            <h4>Zielony matowy</h4>
            <p>
              Unikalny, ekologiczny kolor. Rzadko spotykany na drogach.
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Zastosowania</h3>
        <div class="applications-grid">
          <div class="application-card">
            <div class="app-icon">
              <ImageIcon size={32} />
            </div>
            <h4>Pełne oklejanie</h4>
            <p>
              Zmiana koloru całego pojazdu. Maksymalna ochrona lakieru i nowy wygląd.
            </p>
          </div>

          <div class="application-card">
            <div class="app-icon">
              <ImageIcon size={32} />
            </div>
            <h4>Częściowe oklejanie</h4>
            <p>
              Oklejanie wybranych elementów: maska, zderzak, lusterka, progi.
            </p>
          </div>

          <div class="application-card">
            <div class="app-icon">
              <Palette size={32} />
            </div>
            <h4>Reklamy na pojazdach</h4>
            <p>
              Mobilna reklama Twojej firmy. Efektywna i kosztowa forma promocji.
            </p>
          </div>

          <div class="application-card">
            <div class="app-icon">
              <Star size={32} />
            </div>
            <h4>Floty pojazdów</h4>
            <p>
              Spójny wizerunek marki na całej flocie pojazdów.
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Trendy 2024</h3>
        <div class="trends-list">
          <div class="trend-item">
            <div class="trend-icon">
              <Lightbulb size={24} />
            </div>
            <div class="trend-content">
              <h4>Matowe wykończenia</h4>
              <p>
                Coraz większa popularność matowych wykończeń. Elegancja i subtelność zyskują na znaczeniu.
              </p>
            </div>
          </div>

          <div class="trend-item">
            <div class="trend-icon">
              <Lightbulb size={24} />
            </div>
            <div class="trend-content">
              <h4>Dwukolorowe projekty</h4>
              <p>
                Kreatywne łączenie dwóch kolorów na jednym pojeździe. Unikalne i przyciągające wzory.
              </p>
            </div>
          </div>

          <div class="trend-item">
            <div class="trend-icon">
              <Lightbulb size={24} />
            </div>
            <div class="trend-content">
              <h4>Chromowane akcenty</h4>
              <p>
                Subtelne chromowane elementy na ciemnych kolorach. Luksusowy i nowoczesny efekt.
              </p>
            </div>
          </div>

          <div class="trend-item">
            <div class="trend-icon">
              <Lightbulb size={24} />
            </div>
            <div class="trend-content">
              <h4>Carbonowe wnętrza</h4>
              <p>
                Wzór włókna węglowego na wnętrznych elementach. Sportowy i dynamiczny charakter.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="content-section">
        <div class="cta-section">
          <h3>Zainspirowany?</h3>
          <p>
            Zobacz naszą galerię realizacji lub skontaktuj się z nami, aby omówić swój projekt.
          </p>
          <div class="cta-buttons">
            <a href="/galeria" class="button">
              <ImageIcon size={20} style="display: inline; vertical-align: middle;" />
              Zobacz galerię
            </a>
            <a href="/kontakt" class="button button-secondary">
              Skontaktuj się z nami
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .content-page {
    max-width: 900px;
    margin: 0 auto;
  }

  .content-page h2 {
    color: white;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 2rem;
    text-align: center;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .content-section > p {
    color: var(--color-text-main);
    line-height: 1.8;
    font-size: 1.125rem;
  }

  .content-section h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }

  .styles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .style-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .style-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .style-preview {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .style-color {
    width: 100%;
    height: 100%;
  }

  .style-card h4 {
    color: white;
    font-size: 1.125rem;
    margin: 0;
  }

  .style-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .colors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .color-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: center;
  }

  .color-swatch {
    width: 80px;
    height: 80px;
    border-radius: 0.5rem;
    margin: 0 auto 1rem;
    border: 2px solid var(--color-border);
  }

  .color-item h4 {
    color: white;
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .color-item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .applications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .application-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .application-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .app-icon {
    width: 56px;
    height: 56px;
    background-color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .application-card h4 {
    color: white;
    font-size: 1.125rem;
    margin: 0;
  }

  .application-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .trends-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .trend-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .trend-icon {
    width: 48px;
    height: 48px;
    background-color: var(--color-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    flex-shrink: 0;
  }

  .trend-content h4 {
    color: white;
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .trend-content p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    border-radius: 0.5rem;
    padding: 3rem;
    text-align: center;
  }

  .cta-section h3 {
    color: white;
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button-secondary {
    background-color: transparent;
    border: 2px solid white;
  }

  .button-secondary:hover {
    background-color: white;
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .content-section > p {
      font-size: 1rem;
    }

    .styles-grid,
    .colors-grid,
    .applications-grid,
    .trends-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .style-card,
    .color-item,
    .application-card,
    .trend-item {
      padding: 1.25rem;
    }

    .cta-section {
      padding: 2rem;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .button {
      width: 100%;
    }
  }
</style>
