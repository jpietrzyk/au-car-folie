---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  class={`dark-mode-toggle ${className}`}
  type="button"
  aria-label="Przełącz tryb ciemny"
  id="dark-mode-toggle"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    class="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon icon (shown in light mode) -->
  <svg
    class="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<!-- Live region for announcing theme changes -->
<div id="theme-status" role="status" aria-live="polite" class="sr-only"></div>

<script>
  // Enhance dark mode toggle to announce changes to screen readers
  const darkModeToggle = document.getElementById("dark-mode-toggle");

  if (darkModeToggle) {
    darkModeToggle.addEventListener("click", () => {
      // Announce change to screen readers after a short delay
      // to ensure the theme has been toggled
      setTimeout(() => {
        const themeStatus = document.getElementById("theme-status");
        if (themeStatus) {
          const isDark = document.documentElement.classList.contains("dark");
          themeStatus.textContent = isDark
            ? "Tryb ciemny włączony"
            : "Tryb jasny włączony";
        }
      }, 100);
    });
  }
</script>

<style>
  .dark-mode-toggle {
    position: relative;
  }

  .sun-icon,
  .moon-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* In light mode, show moon icon */
  :root:not(.dark) .sun-icon {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  :root:not(.dark) .moon-icon {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  /* In dark mode, show sun icon */
  :root.dark .sun-icon {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  :root.dark .moon-icon {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }
</style>
