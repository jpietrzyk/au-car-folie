---
import Layout from "../layouts/Layout.astro";
import Navigation from "./Navigation.astro";
import SocialLinks from "./SocialLinks.astro";
import DarkModeToggle from "./DarkModeToggle.astro";
import { Image } from "astro:assets";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="header">
  <div class="container">
    <a href="/" class="logo" aria-label="Car-folie.pl - Strona główna">
      <Image
        src="/images/logo.png"
        alt="Car-folie.pl"
        width="200"
        height="60"
        loading="eager"
      />
    </a>
    <Navigation currentPath={currentPath} />
    <div class="header-actions">
      <DarkModeToggle />
      <SocialLinks />
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-bg-light);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    flex-shrink: 0;
  }

  .logo img {
    height: 60px;
    width: auto;
    transition: transform 0.3s ease;
  }

  .logo:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 1024px) {
    .container {
      flex-wrap: wrap;
    }

    .logo {
      width: 100%;
      text-align: center;
    }

    .logo img {
      height: 50px;
    }
  }

  @media (max-width: 768px) {
    .header {
      padding: 0.75rem 0;
    }

    .logo img {
      height: 40px;
    }
  }
</style>
