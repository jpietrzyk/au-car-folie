---
import PageLayout from "../layouts/PageLayout.astro";
import { Lightbulb, Star, Palette, Image as ImageIcon } from "@lucide/astro";
import Lightbox from "../components/Lightbox.astro";
---

<PageLayout
  title="Car-folie.pl - Inspiracje"
  description="Inspiracje kolorystyczne i projektowe dla oklejania samochodów. Znajdź pomysł na wyjątkowy wygląd auta."
  currentPath="/inspiracje"
  bannerImage="/images/bg_inspiracje.jpg"
  bannerTitle="Inspiracje"
>
  <div class="container">
    <div class="content-page">
      <h2>Car-folie.pl - Inspiracje</h2>

      <div class="content-section">
        <p>
          Inspiracje samochodów oklejonych folią APA. Jesteśmy jedynym
          oficjalnym dystrybutorem tej włoskiej folii w Polsce.
        </p>
      </div>

      <div class="content-section">
        <h3>Galeria inspiracji</h3>
        <div class="inspiracje-gallery">
          <a
            href="/images/image-1.jpg"
            class="gallery-item"
            data-title="Inspiracja 1"
          >
            <img
              src="/images/thumb-1.jpg"
              alt="Inspiracja 1"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-2.jpg"
            class="gallery-item"
            data-title="Inspiracja 2"
          >
            <img
              src="/images/thumb-2.jpg"
