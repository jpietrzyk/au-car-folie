---
import PageLayout from '../layouts/PageLayout.astro';
import { GraduationCap, Users, Award, BookOpen } from '@lucide/astro';
---

<PageLayout
  title="Car-folie.pl - Szkolenia"
  description="Zmiana koloru aut folia, pełne oklejanie, grafika na pojazdach"
  currentPath="/szkolenia"
  bannerImage="/images/bg_szkolenia.jpg"
  bannerTitle="Szkolenia"
>
  <div class="container">
    <div class="content-page">
      <h2>Car-folie.pl - Szkolenia</h2>

      <div class="content-section">
        <p>
          Prowadzimy szkolenia z aplikacji folii. Jeśli oklejasz, lub chcesz zająć się oklejaniem samochodów, zapisz się na nasze profesjonalne szkolenie.
        </p>
      </div>

      <div class="content-section">
        <h3>Dlaczego warto się szkolić?</h3>
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="benefit-icon">
              <GraduationCap size={32} />
            </div>
            <h4>Profesjonalne umiejętności</h4>
            <p>
              Naucz się od doświadczonych aplikatorów z wieloletnią praktyką.
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">
              <Award size={32} />
            </div>
            <h4>Certyfikat</h4>
            <p>
              Otrzymaj certyfikat potwierdzający Twoje umiejętności.
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">
              <Users size={32} />
            </div>
            <h4>Praktyka</h4>
            <p>
              Pracuj na prawdziwych pojazdach pod okiem instruktora.
            </p>
          </div>

          <div class="benefit-card">
            <div class="benefit-icon">
              <BookOpen size={32} />
            </div>
            <h4>Wiedza</h4>
            <p>
              Poznaj sekrety i techniki profesjonalnego oklejania.
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Program szkolenia</h3>
        <div class="program-list">
          <div class="program-item">
            <h4>Teoria</h4>
            <p>
              Podstawy teoretyczne oklejania samochodów folią.
            </p>
            <ul>
              <li>Rodzaje folii i ich właściwości</li>
              <li>Przygotowanie pojazdu</li>
              <li>Narzędzia i akcesoria</li>
              <li>Bezpieczeństwo pracy</li>
            </ul>
          </div>

          <div class="program-item">
            <h4>Praktyka</h4>
            <p>
              Praca na prawdziwych pojazdach pod okiem instruktora.
            </p>
            <ul>
              <li>Aplikacja folii na różnych powierzchniach</li>
              <li>Techniki cięcia i formowania</li>
              <li>Rozwiązywanie problemów</li>
              <li>Końcowa obróbka</li>
            </ul>
          </div>

          <div class="program-item">
            <h4>Zaawansowane techniki</h4>
            <p>
              Profesjonalne techniki dla doświadczonych aplikatorów.
            </p>
            <ul>
              <li>Oklejanie skomplikowanych elementów</li>
              <li>Praca z materiałami specjalistycznymi</li>
              <li>Szybkie i precyzyjne techniki</li>
              <li>Optymalizacja procesu</li>
            </ul>
          </div>

          <div class="program-item">
            <h4>Certyfikacja</h4>
            <p>
              Sprawdzenie umiejętności i wydanie certyfikatu.
            </p>
            <ul>
              <li>Test praktyczny</li>
              <li>Ocena jakości wykonania</li>
              <li>Wydanie certyfikatu</li>
              <li>Wsparcie po szkoleniu</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Co otrzymasz?</h3>
        <div class="includes-grid">
          <div class="include-item">
            <div class="include-check">✓</div>
            <h4>Kompleksowe szkolenie</h4>
            <p>
              Teoria i praktyka pod okiem doświadczonych instruktorów.
            </p>
          </div>

          <div class="include-item">
            <div class="include-check">✓</div>
            <h4>Materiały szkoleniowe</h4>
            <p>
              Wszystkie niezbędne materiały do ćwiczeń.
            </p>
          </div>

          <div class="include-item">
            <div class="include-check">✓</div>
            <h4>Certyfikat</h4>
            <p>
              Oficjalny certyfikat potwierdzający Twoje umiejętności.
            </p>
          </div>

          <div class="include-item">
            <div class="include-check">✓</div>
            <h4>Wsparcie</h4>
            <p>
              Konsultacje i pomoc po zakończeniu szkolenia.
            </p>
          </div>

          <div class="include-item">
            <div class="include-check">✓</div>
            <h4>Materiały edukacyjne</h4>
            <p>
              Skrypty i materiały do dalszej nauki.
            </p>
          </div>

          <div class="include-item">
            <div class="include-check">✓</div>
            <h4>Obiad</h4>
            <p>
              Zapewniamy obiad podczas szkolenia.
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Wymagania uczestników</h3>
        <div class="requirements-list">
          <div class="requirement-item">
            <h4>Doświadczenie</h4>
            <p>
              Preferowane doświadczenie w branży motoryzacyjnej lub reklamowej.
            </p>
          </div>

          <div class="requirement-item">
            <h4>Zainteresowanie</h4>
            <p>
              Chęć nauki i rozwoju w dziedzinie oklejania pojazdów.
            </p>
          </div>

          <div class="requirement-item">
            <h4>Dokładność</h4>
            <p>
              Umiejętność precyzyjnej pracy i dbałość o szczegóły.
            </p>
          </div>

          <div class="requirement-item">
            <h4>Wytrwałość</h4>
            <p>
              Gotowość do pracy przez dłuższy czas.
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <div class="cta-section">
          <h3>Zainteresowany szkoleniem?</h3>
          <p>
            Skontaktuj się z nami, aby zarejestrować się na najbliższe szkolenie lub zapytać o szczegóły.
          </p>
          <a href="/kontakt" class="button">
            Zarejestruj się na szkolenie
          </a>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .content-page {
    max-width: 900px;
    margin: 0 auto;
  }

  .content-page h2 {
    color: white;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 2rem;
    text-align: center;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .content-section > p {
    color: var(--color-text-main);
    line-height: 1.8;
    font-size: 1.125rem;
  }

  .content-section h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .benefit-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .benefit-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .benefit-icon {
    width: 56px;
    height: 56px;
    background-color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .benefit-card h4 {
    color: white;
    font-size: 1.125rem;
    margin: 0;
  }

  .benefit-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .program-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .program-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .program-item h4 {
    color: var(--color-primary);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .program-item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .program-item ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .program-item li {
    color: var(--color-text-main);
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .program-item li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .includes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .include-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: all 0.3s ease;
  }

  .include-item:hover {
    border-color: var(--color-primary);
  }

  .include-check {
    width: 32px;
    height: 32px;
    background-color: var(--color-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-weight: bold;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .include-item h4 {
    color: white;
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .include-item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .requirements-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .requirement-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .requirement-item h4 {
    color: var(--color-primary);
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .requirement-item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    border-radius: 0.5rem;
    padding: 3rem;
    text-align: center;
  }

  .cta-section h3 {
    color: white;
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .content-section > p {
      font-size: 1rem;
    }

    .benefits-grid,
    .program-list,
    .includes-grid,
    .requirements-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .benefit-card,
    .program-item,
    .include-item,
    .requirement-item {
      padding: 1.25rem;
    }

    .include-item {
      flex-direction: column;
      gap: 0.75rem;
    }

    .include-check {
      width: 28px;
      height: 28px;
    }

    .cta-section {
      padding: 2rem;
    }
  }
</style>
