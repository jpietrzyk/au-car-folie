---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
}

const { title, description, image, link } = Astro.props;
---

<article class="service-card scroll-animate-scale">
  <a href={link} class="service-card-link">
    <div class="service-card-image">
      <Image
        src={image}
        alt={title}
        width="640"
        height="360"
        loading="lazy"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        format="webp"
        class="service-card-img"
      />
    </div>
    <div class="service-card-content">
      <h3>{title}</h3>
      <p>{description}</p>
      <span class="service-card-button">
        Dowiedz się więcej
        <ArrowRight size={16} class="arrow-icon" />
      </span>
    </div>
  </a>
</article>

<style>
  .service-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .service-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    border-radius: 0.5rem;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    border-color: var(--color-primary);
  }

  .service-card:hover::before {
    opacity: 0.08;
  }

  .service-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 1;
  }

  .service-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }

  .service-card-image::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .service-card:hover .service-card-image::after {
    opacity: 1;
  }

  .service-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-card:hover .service-card-img {
    transform: scale(1.1);
  }

  .service-card-content {
    padding: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .service-card-content h3 {
    color: var(--color-text-main);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .service-card:hover .service-card-content h3 {
    color: var(--color-primary);
  }

  .service-card-content p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .service-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.875rem;
    transition: all 0.3s ease;
  }

  .arrow-icon {
    transition: transform 0.3s ease;
  }

  .service-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  .service-card:hover .service-card-button {
    color: var(--color-primary-light);
  }

  @media (max-width: 768px) {
    .service-card-content {
      padding: 1.25rem;
    }

    .service-card-content h3 {
      font-size: 1.125rem;
    }
  }
</style>
