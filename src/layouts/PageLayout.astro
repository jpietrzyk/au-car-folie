---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  bannerImage?: string;
  bannerTitle?: string;
  bannerSubtitle?: string;
}

const {
  title,
  description,
  image,
  currentPath = '/',
  bannerImage,
  bannerTitle,
  bannerSubtitle
} = Astro.props;

// Import Banner component only if banner props are provided
const Banner = bannerImage ? (await import('../components/Banner.astro')).default : null;
---

<Layout
  title={title}
  description={description}
  image={image}
  currentPath={currentPath}
>
  <Header currentPath={currentPath} />

  <main>
    {Banner && (
      <Banner
        image={bannerImage}
        title={bannerTitle}
        subtitle={bannerSubtitle}
      />
    )}

    <div class="page-content">
      <slot />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main {
    min-height: calc(100vh - 200px);
  }

  .page-content {
    padding: 3rem 0;
  }

  @media (max-width: 768px) {
    .page-content {
      padding: 2rem 0;
    }
  }
</style>
