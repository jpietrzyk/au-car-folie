            class="gallery-item"
            data-category="floty"
          >
            <img
              src="/img/demopage/thumb-13.jpg"
              alt="Flota - realizacja 1"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-14.jpg"
            class="gallery-item"
            data-category="floty"
          >
            <img
              src="/img/demopage/thumb-14.jpg"
              alt="Flota - realizacja 2"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-15.jpg"
            class="gallery-item"
            data-category="floty"
          >
            <img
              src="/img/demopage/thumb-15.jpg"
              alt="Flota - realizacja 3"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-16.jpg"
            class="gallery-item"
            data-category="floty"
          >
