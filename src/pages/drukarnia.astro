---
import PageLayout from "../layouts/PageLayout.astro";
import { Printer, FileText, Zap, Palette } from "@lucide/astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Drukarnia", current: true },
];
---

<PageLayout
  title="Car-folie.pl - Drukarnia"
  description="Usługi drukarni wielkoformatowej i wydruki na folii do profesjonalnego oklejania pojazdów oraz reklam."
  currentPath="/drukarnia"
  bannerImage="/images/banner.jpg"
  bannerTitle="Drukarnia"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="content-page">
      <h2>Car-folie.pl - Drukarnia</h2>

      <div class="content-section">
        <p>
          Oferujemy profesjonalne usługi drukarskie. Dysponujemy nowoczesnym
          parkiem maszynowym, który pozwala na realizację nawet najbardziej
          skomplikowanych projektów.
        </p>
      </div>

      <div class="content-section">
        <h3>Nasze usługi drukarskie</h3>
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon">
              <Printer size={32} />
            </div>
            <h4>Druk cyfrowy</h4>
            <p>
              Wysokiej jakości druk cyfrowy na różnych materiałach. Idealny do
              reklam, oznakowań i materiałów promocyjnych.
            </p>
            <ul>
              <li>Druk wielkoformatowy</li>
              <li>Różne materiały</li>
              <li>Odporność na UV</li>
              <li>Szybka realizacja</li>
            </ul>
          </div>

          <div class="service-card">
            <div class="service-icon">
              <FileText size={32} />
            </div>
            <h4>Druk ploterowy</h4>
            <p>
              Druk na folii ploterowych do aplikacji na pojazdach i innych
              powierzchniach.
            </p>
            <ul>
              <li>Folie samoprzylepne</li>
              <li>Szeroka gama kolorów</li>
              <li>Wysoka rozdzielczość</li>
              <li>Długa trwałość</li>
            </ul>
          </div>

          <div class="service-card">
            <div class="service-icon">
              <Zap size={32} />
            </div>
            <h4>Druk UV</h4>
            <p>
              Druk z utwardzaniem UV dla zwiększenia trwałości i odporności na
              warunki atmosferyczne.
            </p>
            <ul>
              <li>Utrwalenie UV</li>
              <li>Odporność na warunki</li>
              <li>Wysoka jakość</li>
              <li>Profesjonalne wykończenie</li>
            </ul>
          </div>

          <div class="service-card">
            <div class="service-icon">
              <Palette size={32} />
            </div>
            <h4>Druk sublimacyjny</h4>
            <p>
              Druk na materiałach tekstylnych z wykorzystaniem technologii
              sublimacji.
            </p>
            <ul>
              <li>Wysoka jakość kolorów</li>
              <li>Trwałe nadruki</li>
              <li>Szeroki wybór materiałów</li>
              <li>Profesjonalne wykończenie</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Materiały</h3>
        <div class="materials-grid">
          <div class="material-item">
            <h4>Folie ploterowe</h4>
            <p>
              Wysokiej jakości folie do druku cyfrowego i aplikacji na
              pojazdach.
            </p>
            <ul>
              <li>Folie 3M IJ180, IJ35</li>
              <li>Folie APA ploterowe</li>
              <li>Różne szerokości</li>
              <li>Samoprzylepne</li>
            </ul>
          </div>

          <div class="material-item">
            <h4>Papier i tektura</h4>
            <p>
              Szeroki wybór papierów i materiałów tekstylnych do różnych
              zastosowań.
            </p>
            <ul>
              <li>Papier samoprzylepny</li>
              <li>Tektura bawełniana</li>
              <li>Papier kredowy</li>
              <li>Papier offsetowy</li>
            </ul>
          </div>

          <div class="material-item">
            <h4>Materiały reklamowe</h4>
            <p>
              Kompletna oferta materiałów do reklamy zewnętrznej i wewnętrznej.
            </p>
            <ul>
              <li>Banery</li>
              <li>Plakaty</li>
              <li>Naklejki</li>
              <li>Roll-upy</li>
            </ul>
          </div>

          <div class="material-item">
            <h4>Materiały specjalne</h4>
            <p>Materiały do specjalnych zastosowań i wymagających warunków.</p>
            <ul>
              <li>Materiały odporne na UV</li>
              <li>Materiały wodoodporne</li>
              <li>Materiały ognioodporne</li>
              <li>Materiały antygraffiti</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Zalety naszej drukarni</h3>
        <div class="benefits-list">
          <div class="benefit-row">
            <div class="benefit-check">✓</div>
            <div class="benefit-text">
              <strong>Nowoczesny park maszyn</strong>
              <p>Dysponujemy najnowszymi technologiami drukarskimi.</p>
            </div>
          </div>

          <div class="benefit-row">
            <div class="benefit-check">✓</div>
            <div class="benefit-text">
              <strong>Wysoka jakość</strong>
              <p>Gwarantujemy najwyższą jakość druku i materiałów.</p>
            </div>
          </div>

          <div class="benefit-row">
            <div class="benefit-check">✓</div>
            <div class="benefit-text">
              <strong>Szybka realizacja</strong>
              <p>Terminowe wykonanie zamówień, nawet przy dużych nakładach.</p>
            </div>
          </div>

          <div class="benefit-row">
            <div class="benefit-check">✓</div>
            <div class="benefit-text">
              <strong>Konkurencyjne ceny</strong>
              <p>Atrakcyjne ceny przy zachowaniu wysokiej jakości.</p>
            </div>
          </div>

          <div class="benefit-row">
            <div class="benefit-check">✓</div>
            <div class="benefit-text">
              <strong>Doświadczenie</strong>
              <p>Wiele lat doświadczenia w branży drukarskiej.</p>
            </div>
          </div>

          <div class="benefit-row">
            <div class="benefit-check">✓</div>
            <div class="benefit-text">
              <strong>Kompleksowa obsługa</strong>
              <p>Od projektu po realizację i serwis.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="content-section">
        <div class="cta-section">
          <h3>Zainteresowany naszymi usługami drukarskimi?</h3>
          <p>Skontaktuj się z nami, aby omówić projekt i otrzymać wycenę.</p>
          <a href="/kontakt" class="button"> Skontaktuj się z nami </a>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .content-page {
    max-width: 900px;
    margin: 0 auto;
  }

  .content-page h2 {
    color: white;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 2rem;
    text-align: center;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .content-section > p {
    color: var(--color-text-main);
    line-height: 1.8;
    font-size: 1.125rem;
  }

  .content-section h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .service-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .service-icon {
    width: 56px;
    height: 56px;
    background-color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .service-card h4 {
    color: white;
    font-size: 1.125rem;
    margin: 0;
  }

  .service-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .service-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-card li {
    color: var(--color-text-main);
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .service-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .materials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .material-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .material-item h4 {
    color: var(--color-primary);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .material-item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .material-item ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .material-item li {
    color: var(--color-text-main);
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .material-item li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .benefits-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .benefit-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .benefit-row:hover {
    border-color: var(--color-primary);
  }

  .benefit-check {
    width: 32px;
    height: 32px;
    background-color: var(--color-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-weight: bold;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .benefit-text {
    flex: 1;
  }

  .benefit-text strong {
    color: white;
    font-size: 1.125rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .benefit-text p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .cta-section {
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-primary-dark)
    );
    border-radius: 0.5rem;
    padding: 3rem;
    text-align: center;
  }

  .cta-section h3 {
    color: white;
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .content-section > p {
      font-size: 1rem;
    }

    .services-grid,
    .materials-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service-card,
    .material-item {
      padding: 1.25rem;
    }

    .benefit-row {
      flex-direction: column;
      gap: 1rem;
    }

    .benefit-check {
      width: 28px;
      height: 28px;
    }

    .cta-section {
      padding: 2rem;
    }
  }
</style>
