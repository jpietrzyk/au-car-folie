            class="gallery-item"
            data-title="Inspiracja 4"
          >
            <img
              src="/images/thumb-4.jpg"
              alt="Inspiracja 4"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-5.jpg"
            class="gallery-item"
            data-title="Inspiracja 5"
          >
            <img
              src="/images/thumb-5.jpg"
              alt="Inspiracja 5"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-6.jpg"
            class="gallery-item"
            data-title="Inspiracja 6"
          >
            <img
              src="/images/thumb-6.jpg"
              alt="Inspiracja 6"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-7.jpg"
            class="gallery-item"
            data-title="Inspiracja 7"
          >
            <img
              src="/images/thumb-7.jpg"
              alt="Inspiracja 7"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-8.jpg"
            class="gallery-item"
            data-title="Inspiracja 8"
          >
            <img
              src="/images/thumb-8.jpg"
              alt="Inspiracja 8"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-9.jpg"
            class="gallery-item"
            data-title="Inspiracja 9"
          >
            <img
              src="/images/thumb-9.jpg"
              alt="Inspiracja 9"
              class="inspiracje-image"
            />
          </a>
          <a
            href="/images/image-10.jpg"
            class="gallery-item"
            data-title="Inspiracja 10"
          >
            <img
