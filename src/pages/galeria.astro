---
import PageLayout from "../layouts/PageLayout.astro";
import { Image as ImageIcon, Filter, Grid3x3 } from "@lucide/astro";
import Lightbox from "../components/Lightbox.astro";
---

<PageLayout
  title="Car-folie.pl - Galeria"
  description="Zmiana koloru aut folia, pełne oklejanie, grafika na pojazdach"
  currentPath="/galeria"
  bannerImage="/images/bg_galeria.jpg"
  bannerTitle="Galeria"
>
  <div class="container">
    <div class="content-page">
      <h2>Car-folie.pl - Galeria</h2>

      <div class="content-section">
        <p>
          Zobacz nasze realizacje. Prezentujemy różne projekty oklejania
          samochodów, od zmiany koloru po reklamy na pojazdach.
        </p>
      </div>

      <div class="content-section">
        <div class="gallery-controls">
          <h3>Kategorie</h3>
          <div class="filter-buttons">
            <button class="filter-button active" data-filter="all">
              <Grid3x3 size={20} />
              Wszystkie
            </button>
            <button class="filter-button" data-filter="zmiana-koloru">
              <ImageIcon size={20} />
              Zmiana koloru
            </button>
            <button class="filter-button" data-filter="reklamy">
              <Filter size={20} />
              Reklamy
            </button>
            <button class="filter-button" data-filter="floty">
              <Filter size={20} />
              Floty
            </button>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h3>Zmiana koloru</h3>
        <div class="gallery-grid">
          <a
            href="/img/demopage/image-1.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-1.jpg"
              alt="Zmiana koloru - realizacja 1"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-2.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-2.jpg"
              alt="Zmiana koloru - realizacja 2"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-3.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-3.jpg"
              alt="Zmiana koloru - realizacja 3"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-4.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-4.jpg"
              alt="Zmiana koloru - realizacja 4"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-5.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-5.jpg"
              alt="Zmiana koloru - realizacja 5"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-6.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-6.jpg"
              alt="Zmiana koloru - realizacja 6"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-7.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-7.jpg"
              alt="Zmiana koloru - realizacja 7"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-8.jpg"
            class="gallery-item"
            data-category="zmiana-koloru"
          >
            <img
              src="/img/demopage/thumb-8.jpg"
              alt="Zmiana koloru - realizacja 8"
              loading="lazy"
            />
          </a>
        </div>
      </div>

      <div class="content-section">
        <h3>Reklamy na pojazdach</h3>
        <div class="gallery-grid">
          <a
            href="/img/demopage/image-9.jpg"
            class="gallery-item"
            data-category="reklamy"
          >
            <img
              src="/img/demopage/thumb-9.jpg"
              alt="Reklama - realizacja 1"
              loading="lazy"
            />
          </a>
          <a
            href="/img/demopage/image-10.jpg"
            class="gallery-item"
            data-category="reklamy"
          >
            <img
              src="/img/demopage/thumb-10.jpg"
